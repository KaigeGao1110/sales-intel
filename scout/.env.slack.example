# Scout Slack Bot — Environment Variables
# Copy this file to .env.slack and fill in your values

# ── Bot Token (from OAuth & Permissions) ────────────────────────────────────
# Start with: xoxb-...
SLACK_BOT_TOKEN=

# ── App Token (for Socket Mode) ─────────────────────────────────────────────
# Start with: xapp-...
# Enable Socket Mode in your app's "Socket Mode" section
SLACK_APP_TOKEN=

# ── Signing Secret (from Basic Information) ───────────────────────────────
SLACK_SIGNING_SECRET=

# ── Webhook URL (for incoming webhooks / alert pushes) ─────────────────────
# Optional — used by alerts.py for pushing alert messages to Slack
# Create an Incoming Webhook at: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# ── Default Channel for Alerts ──────────────────────────────────────────────
# Channel ID (not name) to send alert messages to.
# Get the ID by clicking "Copy Link" on a channel — it ends in CXXXXXX
SLACK_CHANNEL_ID=

# ── Local development port ─────────────────────────────────────────────────
SLACK_BOT_PORT=3000
